# HTML 은 항상 새로 받아온다. (디자인을 고쳐도 옛 화면이 남는 문제 방지)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# 파일명/쿼리에 버전이 붙는 자산은 오래 캐시해도 안전하다.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/admin/*
  X-Robots-Tag: noindex, nofollow
